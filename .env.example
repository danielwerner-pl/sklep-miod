# Skopiuj do .env.local. Tylko klucze TESTOWE Stripe (sk_test_…) – aplikacja odrzuca sk_live_.
STRIPE_SECRET_KEY=sk_test_...
# Z `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# E-maile po zamówieniu (opcjonalnie, bez klucza tylko log w konsoli)
RESEND_API_KEY=
EMAIL_FROM="Pasieka <zamowienia@twojadomena.pl>"
SELLER_EMAIL=

# InPost Geowidget v5 (token z Managera Paczek). Bez tokenu: ręczne wpisanie kodu paczkomatu.
NEXT_PUBLIC_INPOST_GEOWIDGET_TOKEN=
NEXT_PUBLIC_INPOST_SANDBOX=1
